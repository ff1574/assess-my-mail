# Base image for Ubuntu with Node.js and other dependencies
FROM vm/ubuntu:22.04

# Install Node.js and other dependencies
RUN curl -fSsL https://deb.nodesource.com/setup_20.x | bash && \
    apt-get install -y nodejs python3 make gcc build-essential && \
    rm -f /etc/apt/sources.list.d/nodesource.list

# Set memory and environment variables
MEMORY 2G
ENV NODE_OPTIONS=--max-old-space-size=8192

# Set the working directory
WORKDIR /app

# Copy the entire repository into the working directory
COPY . .

